# Makine bağlayıcısı ve PLC simülatörü (entegrasyon/). API imajından ayrı ve küçük: protokol
# kütüphaneleri (OPC UA, Modbus, MQTT) ve httpx; Hata Asistanı'nın koduna ve embedding modeline
# bağımlı değil, fabrika ağında makinelerin yanında tek başına çalışabilir. amqtt yalnızca
# simülatörün MQTT aracısı için.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /uygulama
RUN pip install "asyncua>=2.1,<3" "httpx>=0.27" "pymodbus>=3.10,<4" "aiomqtt>=2.3,<3" \
    "amqtt>=0.12,<1"
COPY entegrasyon ./entegrasyon

# Kuyruk dosyası /veri'de (volume): bağlayıcı yeniden başlasa da gönderilmemiş olay kalır.
RUN useradd --create-home baglayici && mkdir /veri && chown baglayici /veri
USER baglayici

CMD ["python", "-m", "entegrasyon.baglayici"]
