# Bu dosyayı .env adıyla kopyala ve değerleri doldur. .env git'e girmez.
# docker compose POSTGRES_* değişkenlerini, uygulama diğerlerini okur.

POSTGRES_USER=andon
POSTGRES_PASSWORD=andon
POSTGRES_DB=andon
POSTGRES_PORT=5432

# Verilmezse uygulama yukarıdaki yerel demo veritabanına (127.0.0.1:5432) bağlanır.
# Başka bir veritabanı için:
# DATABASE_URL=postgresql://<kullanici>:<parola>@<sunucu>:5432/<veritabani>

# Giriş (JWT). Boş bırakılırsa her açılışta rastgele anahtar üretilir ve oturumlar düşer.
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_GIZLI_ANAHTAR=

# seed.py'nin oluşturduğu demo kullanıcılarının (operator, bakim) parolası
DEMO_PAROLA=andon-demo

# LLM sağlayıcısı: gemini (varsayılan) ya da ollama
LLM_SAGLAYICI=gemini

# Google AI Studio'dan alınan anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# İsteğe bağlı: varsayılan model (gemini-3.5-flash-lite) yerine başka bir model, örn. gemini-3.8-flash
# LLM_MODEL=

# Ollama kullanılacaksa (LLM_SAGLAYICI=ollama). Varsayılan model: qwen3:4b
# OLLAMA_URL=http://localhost:11434/v1

# Telegram botu (isteğe bağlı). Telegram'da @BotFather'a /newbot yazıp aldığın token.
# Token bir paroladır: kimseyle paylaşma, git'e koyma.
# TELEGRAM_BOT_TOKEN=
# Botun kullanıcı adı (@ olmadan); arayüzdeki "Telegram'da aç" bağlantısı için.
# TELEGRAM_BOT_KULLANICI_ADI=
# Arıza bildirimi: ayrintili (kılavuz alıntısı ve stok, yalnızca bakım rolüne) ya da kisa
# (yalnızca "hat durdu"). Bot mesajları uçtan uca şifreli değildir.
# TELEGRAM_BILDIRIM_AYRINTISI=ayrintili
# Telegram'dan gelen talep fotoğraflarının saklanacağı gün sayısı
# TELEGRAM_FOTOGRAF_SAKLAMA_GUN=90
# Bakım rolüne her sabah geciken ve o günün periyodik bakımları (Türkiye saati)
# TELEGRAM_BAKIM_OZETI_SAATI=07:30
